{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Public Worker name and the Cloudflare account that owns the custom domain.
  "name": "twilio-paralegal",
  "account_id": "5e1935bae90ba3281d225e4d3b23dc66",
  // pywrangler packages this Python entrypoint and its imported modules.
  "main": "src/entry.py",
  // Embed the editable browser assets in a generated Python module.
  "build": {"command": "python3 scripts/build_console.py"},
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "twilio.genehuntley.com", "custom_domain": true}],
  // Canonical URL used when validating signatures from Twilio.
  "vars": {
    "PUBLIC_VOICE_URL": "https://twilio.genehuntley.com/voice",
    "OPENAI_MODEL": "gpt-4.1-nano",
    "VOICE_TRANSPORT": "relay",
    "ELEVENLABS_VOICE": "OYTbf65OHHFELVut7v2H-flash_v2_5"
  },
  // One stateful room stores recent events and owns live WebSockets.
  "durable_objects": {"bindings": [
    {"name": "TRANSCRIPTS", "class_name": "TranscriptRoom"},
    {"name": "CALLS", "class_name": "CallAgent"},
    {"name": "KNOWLEDGE", "class_name": "KnowledgeBase"}
  ]},
  // This historical tag must remain so Cloudflare preserves the SQLite class.
  "migrations": [
    {"tag": "v1-transcripts", "new_sqlite_classes": ["TranscriptRoom"]},
    {"tag": "v2-agent", "new_sqlite_classes": ["CallAgent", "KnowledgeBase"]}
  ],
  "observability": {"enabled": true, "traces": {"enabled": true, "head_sampling_rate": 0.01}}
}
